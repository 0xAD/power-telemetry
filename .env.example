# Copy to .env and fill in your device credentials.
# The Local Key is a secret — keep .env out of git (it is gitignored).
# It is obtained from the Tuya IoT developer portal (Query Device Details).
DEVICE_IP=192.168.x.x
DEVICE_ID=YOUR_DEVICE_ID
LOCAL_KEY=REPLACE_WITH_YOUR_16_CHAR_LOCAL_KEY

# --- Optional tuning (defaults shown) ---

# Seconds of raw 1 Hz data to keep before pruning (older lives in rollup_1min).
# 0 or unset = keep all raw indefinitely. E.g. 24 h:
#RETAIN_RAW_SECONDS=86400

# Deadband: write a raw row only when a metric changes by at least this much
# since its last write. Raw capture always lands in the in-memory rollup buffer
# (rollup avg/min/max stay full-resolution) regardless of these values.
#DEADBAND_CURRENT=0.05      # A
#DEADBAND_POWER=5.0         # W
#DEADBAND_VOLTAGE=2.0       # V
#DEADBAND_FREQUENCY=0.1     # Hz
#DEADBAND_POWER_FACTOR=0.02
#DEADBAND_ENERGY=1.0        # Wh (cumulative)
#DEADBAND_CPU_TEMP=1.0      # C

# Even if a metric stays inside its deadband, force-write at least this often.
#HEARTBEAT_SECONDS=60

# Collector log verbosity: DEBUG (every push/write/skip), INFO (default),
# WARNING, ERROR. Logs go to stdout (svlogd captures to /var/log/power-telemetry).
#LOG_LEVEL=INFO
